# Build products and local binaries
build/
build_*/
bin/
*.exe
*.obj
*.pdb
*.ilk
*.exp
*.lib

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Tool/runtime transient files
*.tlog
*.lastbuildstate
*.recipe
.tmp/

# Keep recoverable experiment artifacts visible.
!outputs/
!outputs/**/
!outputs/**/*.json
!outputs/**/*.jsonl
!outputs/**/*.csv
!outputs/**/*.md

# Databases
*.sqlite

# Generated run artifacts
*_out/
*_config.json
results/
scratch/
@+*+@
