# Build products and local binaries
build/
build_*/
bin/
*.exe
*.obj
*.pdb
*.ilk
*.exp
*.lib

# Python caches
__pycache__/
*.pyc

# Tool/runtime transient files
*.tlog
*.lastbuildstate
*.recipe

# Keep recoverable experiment artifacts visible.
!outputs/
!outputs/**/
!outputs/**/*.json
!outputs/**/*.jsonl
!outputs/**/*.csv
!outputs/**/*.md
