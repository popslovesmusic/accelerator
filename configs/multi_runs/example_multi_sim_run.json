{
  "run_id": "example_residue_validation",
  "mode": "serial",
  "output_root": "outputs/example_residue_validation",
  "manifest_path": "tool_manifest.json",
  "governance": {
    "require_tool_certification": false,
    "require_validation_dir": false,
    "dry_run_first": true,
    "stop_on_failure": true,
    "allow_uncertified_exploratory": true,
    "claim_interpretation_allowed": false
  },
  "execution": {
    "max_workers": 2,
    "timeout_seconds": 1800,
    "env": {},
    "shell": false
  },
  "jobs": [
    {
      "job_id": "ca_residue_seeded",
      "tool": "ca_admissibility_sim_v1",
      "config": "configs/examples/ca_residue_test.json",
      "seeds": [1, 2, 3],
      "depends_on": [],
      "args": {},
      "output_subdir": "jobs/ca_residue_seeded",
      "claim_role": "evidence_generation"
    },
    {
      "job_id": "fsa_residue_seeded",
      "tool": "fsa_rule_engine_sim_v1",
      "config": "configs/examples/fsa_residue_test.json",
      "seeds": [1, 2, 3],
      "depends_on": [],
      "args": {},
      "output_subdir": "jobs/fsa_residue_seeded",
      "claim_role": "evidence_generation"
    }
  ]
}
