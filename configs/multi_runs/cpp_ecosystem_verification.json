{
  "run_id": "cpp_ecosystem_verification",
  "mode": "parallel",
  "output_root": "outputs/cpp_ecosystem_verification",
  "governance": {
    "require_tool_certification": false,
    "require_validation_dir": false,
    "dry_run_first": false,
    "stop_on_failure": false
  },
  "execution": {
    "max_workers": 8,
    "timeout_seconds": 600
  },
  "jobs": [
    { "job_id": "ca_cpp", "tool": "ca_admissibility_sim_v1_cpp", "config": "configs/examples/ca_residue_test.json" },
    { "job_id": "fsa_cpp", "tool": "fsa_rule_engine_sim_v1_cpp", "config": "configs/examples/fsa_residue_test.json" },
    { "job_id": "analog_cpp", "tool": "dase_analog_sim_cpp", "config": "tools/dase_analog_sim_v1/configs/default.json" },
    { "job_id": "agent_cpp", "tool": "agent_based_sim_v1_cpp", "config": "tools/agent_based_sim_v1/configs/default.json" },
    { "job_id": "stochastic_cpp", "tool": "stochastic_sim_cpp", "config": "tools/stochastic_sim_v1/configs/default.json" },
    { "job_id": "kuramoto_cpp", "tool": "kuramoto_sim_v1_cpp", "config": "tools/kuramoto_sim_v1/configs/default.json" },
    { "job_id": "rd_cpp", "tool": "rd_sim_cpp", "config": "tools/rd_moving_boundary_sim_v1/configs/default.json" },
    { "job_id": "lb_cpp", "tool": "lb_fluid_sim_v1_cpp", "config": "tools/lb_fluid_sim_v1/configs/default.json" },
    { "job_id": "box_cpp", "tool": "structural_box_sim_cpp", "config": "tools/structural_box_sim_v2/configs/default.json" }
  ]
}
