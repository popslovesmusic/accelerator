{
  "run_id": "c4_phase3_uq_all",
  "mode": "parallel",
  "output_root": "outputs/c4_phase3_uq_all",
  "governance": {
    "require_tool_certification": false,
    "require_validation_dir": true,
    "dry_run_first": false,
    "stop_on_failure": false
  },
  "execution": {
    "max_workers": 8,
    "timeout_seconds": 600
  },
  "jobs": [
    {
      "job_id": "uq_agent_based_sim_v1",
      "tool": "agent_based_sim_v1",
      "config": "tools/agent_based_sim_v1/configs/default.json",
      "seeds": [
        100,
        200,
        300
      ],
      "claim_role": "evidence_generation",
      "args": {}
    },
    {
      "job_id": "uq_ca_admissibility_sim_v1",
      "tool": "ca_admissibility_sim_v1",
      "config": "tools/ca_admissibility_sim_v1/configs/default.json",
      "seeds": [
        100,
        200,
        300
      ],
      "claim_role": "evidence_generation",
      "args": {}
    },
    {
      "job_id": "uq_accelerator_sim_v1_cpp",
      "tool": "accelerator_sim_v1_cpp",
      "config": "tools/accelerator_sim_v1/configs/optiplex_default.json",
      "seeds": [
        10,
        20,
        30
      ],
      "claim_role": "evidence_generation",
      "args": {}
    },
    {
      "job_id": "uq_symplectic_sim_v1_cpp",
      "tool": "symplectic_sim_v1_cpp",
      "config": "tools/symplectic_sim_v1_cpp/configs/default.json",
      "seeds": [
        10,
        20,
        30
      ],
      "claim_role": "evidence_generation",
      "args": {}
    },
    {
      "job_id": "uq_satp_higgs_3d_sim_v1",
      "tool": "satp_higgs_3d_sim_v1",
      "config": "configs/examples/ca_residue_test.json",
      "seeds": [
        10,
        20,
        30
      ],
      "claim_role": "evidence_generation",
      "args": {}
    }
  ]
}
