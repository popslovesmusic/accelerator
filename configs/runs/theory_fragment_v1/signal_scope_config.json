{
  "id": "fragment_signal_scope",
  "fixed_seeds": [101, 202, 303],
  "input_surface": "synthetic_signal_frames",
  "not_medical_tool": true,
  "engine": {
    "num_frames": 200,
    "num_nodes": 128,
    "engine_steps_per_frame": 5,
    "connected_state": "train"
  },
  "thresholds": {
    "mismatch_threshold": 0.02,
    "caution_threshold": 0.70,
    "signal_x_threshold": 0.60
  },
  "groove": {
    "max_grooves": 8,
    "create_threshold": 0.85,
    "switch_margin": 0.05
  },
  "inductive": {
    "enabled": true,
    "gain": 1.5
  },
  "required_outputs": [
    "summary.json",
    "metrics.csv"
  ]
}
