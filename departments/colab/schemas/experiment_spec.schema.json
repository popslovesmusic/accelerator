{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acellorator.local/schemas/colab/experiment_spec.schema.json",
  "title": "Colab Experiment Specification",
  "description": "Immutable pre-execution specification for notebook and result-archive evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "schema_version",
    "status",
    "created_at",
    "source_notebook",
    "research_question",
    "hypothesis",
    "independent_variables",
    "dependent_variables",
    "controls",
    "random_seed",
    "parameter_space",
    "termination_conditions",
    "expected_outputs",
    "interpretation_protocol",
    "provenance",
    "immutability"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "const": "IMMUTABLE_SPEC"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_notebook": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "independent_variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "dependent_variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "random_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "seed_scope",
        "derivation_policy"
      ],
      "properties": {
        "value": {
          "type": [
            "integer",
            "string"
          ]
        },
        "seed_scope": {
          "type": "string",
          "minLength": 1
        },
        "derivation_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameter_space": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "termination_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/expected_output"
      }
    },
    "interpretation_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_ceiling",
        "decision_rules",
        "allowed_interpretations",
        "blocked_interpretations"
      ],
      "properties": {
        "claim_ceiling": {
          "type": "string",
          "enum": [
            "C1_SPECIFICATION_ONLY",
            "C2_BOUNDED_NOTEBOOK_OUTPUT",
            "C2_LIMITATION_OR_NEGATIVE_RESULT"
          ]
        },
        "decision_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_interpretations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocked_interpretations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_paths",
        "artifact_hashes"
      ],
      "properties": {
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "immutability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_before_execution",
        "content_sha256",
        "supersession_policy"
      ],
      "properties": {
        "frozen_before_execution": {
          "type": "boolean",
          "const": true
        },
        "content_sha256": {
          "type": "string",
          "minLength": 1
        },
        "supersession_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "definition"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "units_or_scale": {
          "type": "string"
        },
        "allowed_values_or_range": {
          "type": "string"
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "implementation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "values_or_range",
        "sampling_rule"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "values_or_range": {
          "type": "string",
          "minLength": 1
        },
        "units_or_scale": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "sampling_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path_pattern",
        "required",
        "interpretation_role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path_pattern": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "interpretation_role": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
