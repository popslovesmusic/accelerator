    "MPF_GOV_DEPARTMENT_ROOT_INDUCTION_001"
  ],
  "constitutional_rules": [
    {
      "id": "DREG-001",
      "rule": "Every inducted department SHALL have a registry record."
    },
    {
      "id": "DREG-002",
      "rule": "The Department Registry SHALL be the authoritative list of recognized MPF departments."
    },
    {
      "id": "DREG-003",
      "rule": "A department directory alone SHALL NOT constitute full induction without a registry record."
    },
    {
      "id": "DREG-004",
      "rule": "Department status SHALL be tracked separately from claim maturity."
    },
    {
      "id": "DREG-005",
      "rule": "Department dependencies SHALL be explicit."
    },
    {
      "id": "DREG-006",
      "rule": "Department registry records SHALL identify the local SSOT and local AGENTS.md."
    }
  ],
