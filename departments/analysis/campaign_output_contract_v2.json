{
  "contract_id": "ANALYSIS_CAMPAIGN_OUTPUT_CONTRACT_V2",
  "status": "ACTIVE",
  "applies_to": "all Analysis Department crawl campaigns",
  "outcome_values": ["SUCCESS", "PARTIAL_SUCCESS", "NO_NEW_INFORMATION", "FAILED", "BLOCKED", "INVALID_SCOPE"],
  "executive_recommendation_values": ["PROMOTE", "CONTINUE_RESEARCH", "EXPAND_SCOPE", "SEEK_COUNTEREXAMPLES", "FORMALIZE", "RUN_SIMULATIONS", "STOP_UNTIL_NEW_EVIDENCE"],
  "required_outputs": ["campaign_summary.md", "campaign_summary.json", "proof_readiness_dashboard.json", "research_debt_progress.json", "next_campaign.json", "human_review_checklist.md"],
  "required_metrics": {
    "objective_completion": ["objectives_completed", "objectives_total", "completion_percent"],
    "novelty": ["new_concepts", "duplicate_findings", "superseded_findings", "novelty_score"],
    "proof_readiness": ["candidate_theorems", "proved", "blocked", "counterexamples_found", "proof_obligations_remaining"],
    "quality": ["scope_coverage", "dependency_resolution", "reasoning_depth_used", "termination_quality", "evidence_quality"]
  },
  "required_summary_sections": ["Campaign Purpose", "Scope", "Objects Analyzed", "What Was Learned", "What Was Not Learned", "Major Discoveries", "Proof Progress", "New Contradictions", "Open Research Debt", "Campaign Assessment", "Recommended Next Campaign", "Reason Campaign Stopped"],
  "required_review_questions": ["Do you accept the findings?", "Should candidate objects be preserved?", "Should the proposed campaign be executed?", "Are additional sources required?", "Should governance records be updated?"],
  "authority": {"canonical_promotion": false, "execution_authority": false, "human_review_required": true}
}
