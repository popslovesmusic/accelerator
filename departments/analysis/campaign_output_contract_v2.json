  "required_task_impact_fields": ["unlocks", "blocked_objects", "future_campaigns_enabled", "estimated_effort", "estimated_compute_cost", "expected_repository_value", "blocking_tasks_removed", "risk", "confidence", "repository_unlock_value", "proof_impact", "dependency_reduction", "research_debt_reduction", "governance_importance"],
  "required_handoff_fields": ["current_agent", "recommended_next_agent", "reason", "mission", "expected_outputs", "success_definition"],
