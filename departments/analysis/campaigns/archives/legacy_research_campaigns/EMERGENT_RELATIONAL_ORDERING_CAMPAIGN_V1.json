{
  "campaign_spec": {
    "id": "EMERGENT_RELATIONAL_ORDERING_CAMPAIGN_V1",
    "purpose": "Investigate whether interacting recursive triadic basins generate persistent higher-order relational ordering structures through residue-conditioned asymmetric coupling.",

    "scope_guardrail": {
      "allowed_claims": [
        "ordered relational extension within the simulation substrate",
        "cross-basin orientation coherence",
        "history-conditioned topology evolution",
        "recursive closure mediated ordering"
      ],
      "forbidden_claims": [
        "real spacetime derivation",
        "actual cosmological claims",
        "physical force replacement",
        "literal particle ontology"
      ]
    },

    "primary_question": "Do residue-conditioned interacting triadic basins self-organize into stable large-scale ordering structures that are not reducible to local closure alone?",

    "core_hypothesis": {
      "statement": "Persistent large-scale relational ordering emerges only while local recursive closure and asymmetric coupling remain active.",
      "canonical_relations": [
        "(ℰ≠0) <->_R δ_a(ℰ>0)",
        "D(S1|S2)>0 <->_xa 0<(S2|S1)D",
        "space_app <->_x matter_app <-> energy_app"
      ]
    },

    "global_rules": {
      "minimum_seeds": 16,
      "block_size": 256
    },

    "execution_model": {
      "small_validation_mode": {
        "backend": "CPU_AVX2",
        "triads": [
          256,
          1024,
          4096
        ],
        "purpose": "Correctness and local ordering validation."
      },
      "large_ordering_mode": {
        "backend": "Layered_AVX2_UHD770",
        "triads": [
          65536,
          262144,
          1048576
        ],
        "purpose": "Large-scale ordering emergence."
      }
    },

    "substrate_architecture": {
      "node": "minimal distinguishability carrier",
      "triad": "minimum recursively stable detectable mismatch structure above floor",
      "channels": {
        "in_channel": "incoming mismatch pressure",
        "out_channel": "outgoing projection",
        "recursive_reinforcement_channel": "residue inscription and closure stabilization",
        "coupling_channel": "cross-basin residue-conditioned exchange"
      }
    },

    "required_mechanisms": [
      "recursive_reinforcement",
      "residue_history",
      "adaptive_admissibility",
      "orientation_mediation",
      "dynamic_topology",
      "cross_basin_coupling"
    ],

    "phase_1_orientation_domain_formation": {
      "purpose": "Determine whether coherent orientation regions emerge from local closure.",
      "tests": [
        "orientation_cluster_detection",
        "orientation_stability_over_time",
        "orientation_boundary_interactions",
        "orientation_recovery_after_perturbation"
      ],
      "success_conditions": [
        "stable_orientation_domains",
        "cross_seed_reproducibility",
        "boundary_coherence"
      ]
    },

    "phase_2_cross_basin_ordering": {
      "purpose": "Measure ordering relations between stabilized basins.",
      "tests": [
        "cross_basin_gradient_formation",
        "ordering_field_stability",
        "residue_conditioned_coupling_patterns",
        "coupling_field_coherence"
      ],
      "required_outputs": [
        "ordering_field_map",
        "gradient_entropy",
        "coupling_density",
        "cross_basin_persistence"
      ]
    },

    "phase_3_boundary_mediation": {
      "purpose": "Determine whether boundary conditions influence ordering behavior.",
      "tests": [
        "boundary_scramble",
        "boundary_reflection",
        "boundary_asymmetry",
        "boundary_collapse_propagation"
      ],
      "target_observables": [
        "orientation_deflection",
        "propagation_redirection",
        "ordering_field_curvature",
        "boundary_induced_instability"
      ]
    },

    "phase_4_topology_evolution": {
      "purpose": "Test whether residue-conditioned topology evolves persistently.",
      "tests": [
        "adaptive_coupling_rewiring",
        "topology_memory",
        "residue_driven_path_preference",
        "collapse_reorganization"
      ],
      "required_metrics": [
        "topology_stability",
        "rewire_frequency",
        "historical_path_dependence",
        "identity_persistence"
      ]
    },

    "phase_5_large_scale_ordering": {
      "purpose": "Evaluate whether substrate-wide ordering structures emerge at scale.",
      "tests": [
        "global_ordering_field",
        "multi_basin_coherence",
        "large_scale_orientation_domains",
        "ordering_persistence_under_noise"
      ],
      "required_outputs": [
        "global_field_maps",
        "ordering_spectra",
        "basin_distribution",
        "field_coherence_statistics"
      ]
    },

    "required_metrics": {
      "local_metrics": [
        "closure_strength",
        "residue_density",
        "orientation_stability",
        "inside_admissibility_rate"
      ],
      "global_metrics": [
        "ordering_field_coherence",
        "cross_basin_gradient_strength",
        "topology_memory_index",
        "global_orientation_entropy",
        "space_app_projection_metric"
      ],
      "identity_metrics": [
        "basin_signature_persistence",
        "closure_hysteresis",
        "reentry_probability",
        "post_collapse_recovery_similarity"
      ]
    },

    "falsification_campaign": {
      "purpose": "Attempt to destroy emergent ordering claims.",
      "vectors": [
        {
          "id": "FV_13",
          "name": "Topology Freeze",
          "attack": "Disable adaptive topology evolution.",
          "failure_condition": "Ordering fields remain unchanged."
        },
        {
          "id": "FV_14",
          "name": "Admissibility Lock",
          "attack": "Freeze admissibility windows.",
          "failure_condition": "History-conditioned persistence remains unchanged."
        },
        {
          "id": "FV_15",
          "name": "Residue Suppression",
          "attack": "Zero or heavily damp residue propagation.",
          "failure_condition": "Cross-basin ordering survives identically."
        },
        {
          "id": "FV_16",
          "name": "Coupling Symmetry Enforcement",
          "attack": "Force perfect symmetric coupling.",
          "failure_condition": "Orientation coherence persists."
        },
        {
          "id": "FV_17",
          "name": "Boundary Randomization",
          "attack": "Continuously randomize boundary conditions.",
          "failure_condition": "Stable ordering fields persist unchanged."
        },
        {
          "id": "FV_18",
          "name": "Closure Removal",
          "attack": "Disable recursive reinforcement channels.",
          "failure_condition": "Global ordering remains stable."
        },
        {
          "id": "FV_19",
          "name": "Topology Noise Flood",
          "attack": "Inject random coupling rewires each interval.",
          "failure_condition": "Persistent topology memory remains unaffected."
        }
      ]
    },

    "promotion_requirements": {
      "all_required": [
        "orientation_domains_reproducible",
        "ordering_fields_depend_on_closure",
        "ordering_fields_depend_on_residue",
        "ordering_fields_fail_under_symmetry_attack",
        "topology_memory_persists_across_seeds",
        "backend_equivalence_validated",
        "large_scale_ordering_not_random"
      ]
    },

    "maximum_supported_claim": {
      "statement": "Within this simulation model, interacting recursive triadic basins generate persistent higher-order relational ordering structures through residue-conditioned asymmetric coupling."
    },

    "required_outputs": {
      "format": "JSON",
      "must_include": [
        "config",
        "seed",
        "hardware",
        "backend",
        "triad_count",
        "sync_interval",
        "ordering_metrics",
        "field_maps",
