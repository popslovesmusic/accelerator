        {
          "id": "FV_25",
          "name": "Coupling Nullification",
          "attack": "Disable cross-basin coupling channels.",
          "failure_condition": "Large-scale curvature fields remain."
        },
        {
          "id": "FV_26",
          "name": "Topology Noise Flood",
