{
  "campaign_spec": {
    "id": "GRAVITY_APP_RELATIONAL_CURVATURE_CAMPAIGN_V1",
    "purpose": "Investigate whether persistent residue-supported phase signatures deform admissible continuation paths of neighboring triadic basins in a gravity_app-like manner within the simulation substrate.",

    "scope_guardrail": {
      "status": "analogy_projection_only",
      "allowed_claims": [
        "relational ordering effects",
        "continuation-path deformation",
        "residue-conditioned traversal bias",
        "apparent curvature within the substrate"
      ],
      "forbidden_claims": [
        "literal gravity derivation",
        "replacement for GR",
        "physical spacetime proof",
        "real mass-energy equivalence"
      ]
    },

    "core_hypothesis": {
      "statement": "Dense residue-supported phase signatures lower admissible continuation cost for compatible neighboring trajectories, producing apparent curvature/attraction behavior in the relational substrate.",
      "canonical_relations": [
        "(ℰ≠0) <->_R δ_a(ℰ>0)",
        "D(S1|S2)>0 <->_xa 0<(S2|S1)D",
        "space_app <->_x (matter_app <-> energy_app)"
      ]
    },

    "gravity_app_definition": {
      "short_form": "gravity_app is apparent curvature/attraction behavior produced when residue-weighted mismatch constrains admissible continuation into lower-cost relational paths.",
      "key_mechanisms": [
        "residue-conditioned continuation",
        "phase-signature persistence",
        "orientation-mediated admissibility",
        "cross-basin ordering gradients"
      ]
    },

    "execution_model": {
      "small_validation": {
        "backend": "CPU_AVX2",
        "triads": [
          256,
          1024,
          4096
        ],
        "purpose": "Local curvature and continuation-path validation."
      },
      "large_field_mode": {
        "backend": "Layered_AVX2_UHD770",
        "triads": [
          65536,
          262144,
          1048576
        ],
        "purpose": "Large-scale ordering and curvature-field emergence."
      }
    },

    "substrate_model": {
      "node": "minimal distinguishability carrier",
      "triad": "minimum recursively stable detectable mismatch structure",
      "phase_signature": "persistent recursive orientation/residue configuration",
      "residue": "history lowering continuation cost along compatible phase signatures",
      "orientation_field": "global array of local admissible continuation references",
      "continuation_path": "ordered admissible traversal under orientation mediation"
    },

    "phase_1_local_curvature_validation": {
      "purpose": "Determine whether stable phase signatures bias nearby continuation trajectories.",
      "tests": [
        "single_dense_basin",
        "multi_basin_interaction",
        "trajectory_deflection",
        "orientation_alignment_bias",
        "continuation_cost_gradient"
      ],
      "required_metrics": [
        "trajectory_bending_angle",
        "continuation_cost_delta",
        "local_ordering_gradient",
        "orientation_alignment_score"
      ],
      "success_conditions": [
        "repeatable_trajectory_bias",
        "residue_dependent_path_preference",
        "non_random_orientation_alignment"
      ]
    },

    "phase_2_phase_signature_mass_effect": {
      "purpose": "Determine whether larger/more stable phase signatures produce stronger continuation constraints.",
      "tests": [
        "small_signature_vs_large_signature",
        "high_residue_vs_low_residue",
        "stable_vs_unstable_basins",
        "signature_density_sweep"
      ],
      "required_metrics": [
        "path_deviation_strength",
        "ordering_radius",
        "constraint_gradient_strength",
        "continuation_resistance"
      ],
      "target_behavior": "larger residue-supported signatures produce stronger path deformation."
    },

    "phase_3_inertia_like_behavior": {
      "purpose": "Determine whether stable phase signatures resist reorientation.",
      "tests": [
        "external_orientation_drive",
        "forced_reorientation",
        "cross_basin_alignment_pressure",
        "high_noise_perturbation"
      ],
      "required_metrics": [
        "reorientation_latency",
        "signature_persistence",
        "orientation_recovery_rate",
        "identity_survival_score"
      ],
      "target_behavior": "stable signatures resist rapid orientation change."
    },

    "phase_4_geodesic_like_continuation": {
      "purpose": "Determine whether continuation naturally follows lower-cost admissible paths.",
      "tests": [
        "free_trajectory_traversal",
        "multi_basin_corridor_navigation",
        "boundary_condition_steering",
        "residue_gradient_following"
      ],
      "required_metrics": [
        "least_cost_path_match",
        "trajectory_efficiency",
        "continuation_path_stability",
        "ordering_corridor_coherence"
      ],
      "target_behavior": "trajectories preferentially follow lower-cost continuation corridors."
    },

    "phase_5_large_scale_relational_curvature": {
      "purpose": "Evaluate whether many interacting phase signatures generate substrate-wide curvature-like ordering.",
      "tests": [
        "global_ordering_field",
        "large_scale_gradient_formation",
        "cross_basin_trajectory_lensing",
        "orientation_domain_interference",
        "residue_field_superposition"
      ],
      "required_outputs": [
        "ordering_field_maps",
        "continuation_cost_maps",
        "trajectory_lensing_statistics",
        "orientation_field_entropy",
        "phase_signature_distribution"
