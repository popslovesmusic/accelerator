{
  "tests": [
    {
      "name": "CDHDS FSA: forbidden state never occupied",
      "target_script": "../../wrappers/cdhds_fsa_runner.py",
      "base_config": "../../configs/cdhds_fsa_baseline.json",
      "overrides": {
        "engine_config": {
          "seed": 101,
          "steps": 60
        }
      },
      "assertions": [
        "forbidden_occupancy_events_total == 0.0",
        "transitions_to_forbidden_total == 0.0"
      ]
    },
    {
      "name": "CDHDS Graph: recoupling only from admissible candidate set",
      "target_script": "../../wrappers/cdhds_graph_runner.py",
      "base_config": "../../configs/cdhds_graph_baseline.json",
      "overrides": {
        "engine_config": {
          "seed": 101,
          "steps": 400
        }
      },
      "assertions": [
        "inadmissible_edge_add_fraction_max == 0.0"
      ]
    },
    {
      "name": "CDHDS RD Negative Control: outside activation fails to recouple within window",
      "target_script": "../../wrappers/cdhds_rd_runner.py",
      "base_config": "../../configs/cdhds_rd_negative_no_recouple.json",
      "overrides": {
        "engine_config": {
          "seed": 101,
          "steps": 400
        }
      },
      "assertions": [
        "outside_activation_no_recouple_fraction_max > 0.0"
      ]
    }
  ]
}

