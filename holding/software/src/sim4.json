{
  "scan_plan": {
    "project": "Level2_lambda_transition_scan",
    "purpose": "locate first departure from rapid global exclusion completion and identify onset of structured persistence",
    "base_parameters": {
      "kappa": 0.55,
      "initial_conditions": ["ic0", "ic1", "ic2"],
      "replicates_per_condition": 3,
      "metrics_to_record": [
        "interface_loss_time",
        "final_regime_classification",
        "front_velocity",
        "domain_count",
        "variance_timeseries"
      ]
    },

    "scan_order": [

      {
        "scan_id": "S1_lambda_transition_probe",
        "priority": 1,
        "description": "Bridge scan immediately above known rapid-exclusion window",
        "lambda_range": {
          "start": 0.04,
          "end": 0.10,
          "step": 0.005
        },
        "expected_outcome": [
          "rapid_exclusion_continuation",
          "delayed_exclusion",
          "first_IC_sensitivity"
        ],
        "stop_condition": "mixed_regimes_detected"
      },

      {
        "scan_id": "S2_lambda_transition_expansion",
        "priority": 2,
        "description": "If S1 still shows uniform rapid exclusion, extend scan upward",
        "lambda_range": {
          "start": 0.10,
          "end": 0.20,
          "step": 0.01
        },
        "expected_outcome": [
          "critical_slowing",
          "first_boundary_persistence",
          "multi_domain_onset"
        ],
        "run_condition": "execute_only_if_S1_uniform"
      },

      {
        "scan_id": "S3_lambda_transition_resolution",
        "priority": 3,
        "description": "High resolution scan around first detected transition",
        "lambda_range": {
          "center": "lambda_transition_estimate",
          "half_width": 0.02,
          "step": 0.002
        },
        "expected_outcome": [
          "precise_transition_location",
          "critical_slowing_peak",
          "regime_boundary"
        ],
        "run_condition": "execute_after_transition_detected"
      }
    ],

    "analysis_targets": {
      "primary": [
        "collapse_time_vs_lambda",
        "variance_increase_vs_lambda",
        "IC_outcome_divergence",
        "front_persistence"
      ],
      "secondary": [
        "autocorrelation_growth",
        "domain_size_distribution",
        "front_velocity_distribution"
      ]
    },

    "expected_transition_signature": {
      "indicators": [
        "rapid_increase_in_interface_loss_time",
        "variance_growth_between_runs",
        "initial_condition_sensitivity",
        "appearance_of_boundary_propagation"
      ]
    }
  }
}