{
  "schema_name": "paper1_ode_run_schema",
  "schema_version": "0.1",
  "equation_mode": "ode",
  "required_config_fields": [
    "run_id",
    "experiment_family",
    "equation_mode",
    "parameters",
    "time_settings",
    "initial_conditions",
    "seed",
    "notes"
  ],
  "required_parameter_fields": [
    "k",
    "b",
    "c",
    "alpha",
    "beta",
    "gamma",
    "v",
    "s",
    "h",
    "kappa",
    "lambda"
  ],
  "required_time_settings_fields": [
    "dt",
    "t_final",
    "sample_every"
  ],
  "required_initial_condition_fields": [
    "epsilon0",
    "rho0",
    "R0"
  ],
  "required_outputs": [
    "run_manifest.json",
    "config_snapshot.json",
    "timeseries_global.csv",
    "final_summary.csv",
    "run_summary.md"
  ]
}
