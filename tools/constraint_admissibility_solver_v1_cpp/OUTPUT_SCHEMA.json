{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConstraintAdmissibilitySolverOutput",
  "type": "object",
  "properties": {
    "tool_name": { "type": "string" },
    "tool_version": { "type": "string" },
    "run_id": { "type": "string" },
    "mechanism_class": { "type": "string" },
    "configuration_hash": { "type": "string" },
    "implementation_hash": { "type": "string" },
    "status": { "type": "string", "enum": ["success", "failed", "unstable", "invalid"] },
    "decision": { "type": "string", "enum": ["SAT", "UNSAT"] },
    "witness_assignment": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "unsatisfied_core": {
      "type": "array",
      "items": { "type": "string" }
    },
    "solver_backend": { "type": "string" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": { "type": "object" }
  },
  "required": [
    "tool_name",
    "tool_version",
    "run_id",
    "mechanism_class",
    "configuration_hash",
    "implementation_hash",
    "status",
    "decision"
  ]
}
