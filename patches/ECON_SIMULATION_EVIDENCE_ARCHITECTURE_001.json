{
  "patch_id": "ECON_SIMULATION_EVIDENCE_ARCHITECTURE_001",
  "status": "ACTIVE",
  "purpose": "Track, preserve, cite, audit, and reuse all simulation-derived evidence produced by the Economics Department.",
  "core_principle": "Simulation results are first-class evidence objects. Claims do not cite papers; claims cite simulations.",
  "directory_structure": {
    "evidence_dir": "docs/economics/evidence/",
    "simulations_dir": "docs/economics/simulations/"
  },
  "required_citation_form": "[ECON_EVIDENCE_0001] or [SIM_TOPOLOGY_001] inside procedural_economics_ssot.md",
  "evidence_classes": [
    "TOPOLOGY_EVIDENCE",
    "DEFORMATION_EVIDENCE",
    "RECOVERY_EVIDENCE",
    "COUPLING_EVIDENCE",
    "FRAGILITY_EVIDENCE",
    "METRIC_EVIDENCE"
  ],
  "department_health_metric": {
    "name": "Simulation Coverage Ratio (SCR)",
    "formula": "SCR = claims_with_simulation_support / total_claims",
    "target": 1.0
  }
}
