{
  "meta": {
    "version": "1.0",
    "description": "Maps claim status to allowed and forbidden language for output generation.",
    "independent_measurement_language_constraint": {
      "rule": "Do not use C4+ support language unless independent_measurement.present is true.",
      "blocked_language_without_measurement": [
        "validated across mechanisms",
        "structurally confirmed",
        "independently verified",
        "robustly supports"
      ],
      "allowed_language_without_measurement": [
        "is consistent with",
        "suggests within tested dynamics",
        "supported by dynamics mechanisms only"
      ]
    }
  },
  "policies": {
    "C0_unformed": {
      "allowed": ["idea", "intuition", "speculative"],
      "forbidden": ["suggests", "supports", "demonstrates", "proves"]
    },
    "C1_defined": {
      "allowed": ["proposed", "hypothesized"],
      "forbidden": ["supports", "demonstrates", "proves"]
    },
    "C2_test_designed": {
      "allowed": ["testable", "under investigation"],
      "forbidden": ["supports", "demonstrates", "proves"]
    },
    "C3_single_mechanism_supported": {
      "allowed": ["suggests", "is consistent with", "indicates within this model"],
      "forbidden": ["proves", "confirms reality", "establishes law"]
    },
    "C4_dual_mechanism_supported": {
      "allowed": ["supports", "is strongly consistent with", "validated across mechanisms"],
      "forbidden": ["proves", "establishes fundamental law"]
    },
    "C5_replicated": {
      "allowed": ["robustly supports", "consistently observed"],
      "forbidden": ["proves ultimate truth"]
    },
    "C6_external_ready": {
      "allowed": ["empirically supported within tested scope", "demonstrates under defined conditions"],
      "forbidden": ["absolute proof", "final theory"]
    },
    "H_on_hold": {
      "allowed": ["uncertain", "inconclusive"],
      "forbidden": ["supports", "demonstrates", "proves"]
    },
    "R_rejected": {
      "allowed": ["falsified", "not supported"],
      "forbidden": ["supports", "suggests", "valid"]
    }
  }
}
