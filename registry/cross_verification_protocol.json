{
"cross_verification_protocol": {
"version": "v1.0",

```
"step_1_define_observable": {
  "description": "Convert theory into measurable outputs",
  "examples": {
    "phase_locking": ["order_parameter"],
    "structure": ["active_fraction", "connected_components"],
    "threshold_behavior": ["crossing_fraction"],
    "topology": ["betti_0_count"]
  }
},

"step_2_run_multiple_tools": {
  "min_tools": 2,
  "recommended": 3,
  "rule": "tools must represent different model classes (discrete, continuous, network, stochastic)"
},

"step_3_normalize_outputs": {
  "method": "rescale all observables to [0,1] or z-score",
  "purpose": "make cross-tool comparison valid"
},

"step_4_compare": {
  "agreement_thresholds": {
    "strong_agreement": "correlation > 0.8",
    "partial_agreement": "0.4 < correlation <= 0.8",
    "contradiction": "correlation <= 0.4"
  }
},

"step_5_classify_result": {
  "outputs": [
    "supported",
    "partially_supported",
    "not_supported"
  ]
},

"step_6_falsification_check": {
  "requirement": "run falsification_suite_v1 if result is 'supported'",
  "purpose": "ensure behavior is not trivial or forced"
}
```

}
}
