{
  "protocol": "lexicon_sidecar_v1",
  "resolution_priority": [
    "exact_canonical_match",
    "approved_alias_match",
    "primitive_rewrite_match",
    "role_equivalence_match",
    "new_gap_term"
  ],
  "tie_breakers": [
    "prefer_existing_canonical_term",
    "prefer_highest_validation_level",
    "prefer_narrowest_operational_role",
    "otherwise_mark_AMBIGUOUS_GAP"
  ],
  "claim_ceiling_rules": {
    "GAP_OPEN": "proposed_interpretation",
    "L0": "provisional",
    "L1": "partially_supported",
    "L2": "partially_supported_with_limits",
    "L3": "supported"
  },
  "forbidden_actions": [
    "auto_promote_to_verified",
    "overwrite_registry_without_backup",
    "bypass_gap_queue_for_unknown_terms"
  ]
}
