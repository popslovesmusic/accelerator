{
  "registry_id": "PCD_KNOWLEDGE_INGESTION_REBUILD_MANIFEST",
  "version": "1.0.0",
  "inputs": [
    "registry/*.json",
    "registry/reports/*.json",
    "docs/tech_notes/*.md",
    "docs/theory/foundational/**/*.md",
    "results/**/empirical_result_package.json",
    "results/**/provenance_manifest.json",
    "results/**/recoverable_output_index.json"
  ],
  "checks": [
    "canonical_json_parse_ok",
    "markdown_frontmatter_parse_ok",
    "content_hashes_computed",
    "sqlite_schema_current",
    "fts_index_built",
    "formal_object_references_resolved",
    "artifact_paths_recoverable",
    "context_packet_sources_resolvable",
    "agent_memory_sources_resolvable"
  ]
}
