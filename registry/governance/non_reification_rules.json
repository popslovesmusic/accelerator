{
  "registry_id": "MPF_NON_REIFICATION_RULES",
  "version": "1.0.0",
  "description": "A set of machine-readable rules to detect and block the reification of derived projections into primitive substances.",
  "rules": [
    {
      "rule_id": "NON-REIFY-001",
      "target_object": "geometry",
      "forbidden_phrases": [
        "pre-existing landscape",
        "geometric substrate",
        "container for the process"
      ],
      "required_concept": "Geometry must be described as a stabilized process projection."
    },
    {
      "rule_id": "NON-REIFY-002",
      "target_object": "topology",
      "forbidden_phrases": [
        "background grid",
        "static graph",
        "container for the process"
      ],
      "required_concept": "Topology must be described as an admissibility-conditioned accessibility graph."
    },
    {
      "rule_id": "NON-REIFY-003",
      "target_object": "identity",
      "forbidden_phrases": [
        "enduring object",
        "permanent entity",
        "static thing"
      ],
      "required_concept": "Identity must be described as operational continuity."
    },
    {
      "rule_id": "NON-REIFY-004",
      "target_object": "observer",
      "forbidden_phrases": [
        "external viewpoint",
        "privileged frame",
        "absolute measurement"
      ],
      "required_concept": "Observation must be described as a local, budget-constrained process projection."
    }
  ]
}
