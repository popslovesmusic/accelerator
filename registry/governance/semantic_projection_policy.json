{
  "semantic_projection_governance": {
    "version": "1.0",
    "purpose": [
      "Prevent ontological overclaim",
      "Preserve analogy communication clarity",
      "Separate procedural primitives from projected observables",
      "Reduce semantic drift across papers, agents, registries, and derivations",
      "Distinguish framework-internal operators from external physics terminology"
    ],
    "core_rule": {
      "statement": "All externally recognizable physics or cosmology terminology used within the framework MUST be explicitly marked as projection, analogy, apparent structure, or interpretive mapping unless formally proven equivalent.",
      "enforcement": "mandatory"
    },
    "projection_suffix_registry": {
      "_app": {
        "meaning": "apparent macroscopic projection",
        "example": "gravity_app"
      },
      "_proj": {
        "meaning": "projection mapping or projected interpretation",
        "example": "space_proj"
      },
      "_analog": {
        "meaning": "analogy-only construct",
        "example": "BigBang_analog"
      },
      "_rel": {
        "meaning": "relational construct",
        "example": "time_rel"
      },
      "_proc": {
        "meaning": "procedural primitive",
        "example": "curvature_proc"
      },
      "_geom": {
        "meaning": "geometric projection",
        "example": "time_geom"
      },
      "_obs": {
        "meaning": "observer-scale observable",
        "example": "mass_obs"
      },
      "_phys": {
        "meaning": "canonical physics-domain object",
        "example": "gravity_phys"
      }
    },
    "formal_usage_rules": [
      {
        "rule_id": "SPR-001",
        "description": "Unmarked physics terminology is prohibited inside formal derivations unless explicitly referring to canonical physics."
      },
      {
        "rule_id": "SPR-002",
        "description": "Framework primitives and projected observables must remain semantically separated."
      },
      {
        "rule_id": "SPR-003",
        "description": "Projection language must not imply ontological identity."
      },
      {
        "rule_id": "SPR-004",
        "description": "Analog mappings should prefer projection relations over equality relations."
      },
      {
        "rule_id": "SPR-005",
        "description": "The symbols '=', '≡', and '⇔' are prohibited between framework primitives and physics analog terms unless equivalence is formally derived and validated."
      }
    ],
    "recommended_projection_relations": {
      "maps_to_projection": {
        "symbol": "↦",
        "usage": "procedural structure projects as observable analog"
      },
      "analog_correspondence": {
        "symbol": "≈",
        "usage": "weak analogy or interpretive similarity"
      },
      "emergent_projection": {
        "symbol": "⇒_proj",
        "usage": "projected macroscopic emergence"
      }
    },
    "approved_examples": [
      {
        "valid": true,
        "expression": "κ ↦ gravity_app"
      },
      {
        "valid": true,
        "expression": "Top_A ⇒_proj space_app"
      },
      {
        "valid": true,
        "expression": "BigBang_analog"
      },
      {
        "valid": true,
        "expression": "time_rel"
      },
      {
        "valid": false,
        "expression": "gravity = κ",
        "reason": "implies ontological identity"
      },
      {
        "valid": false,
        "expression": "space = topology",
        "reason": "collapses projection layer into primitive layer"
      }
    ],
    "layer_separation_model": {
      "primitive_layer": [
        "ε",
        "ρ",
        "δ",
        "R",
        "Π_A",
        "NavT",
        "-(i)"
      ],
      "stabilization_layer": [
        "triadic_lock",
        "phase_signature",
        "orientation_selection",
        "homological_closure"
      ],
      "projection_layer": [
        "space_app",
        "time_app",
        "gravity_app",
        "field_analog",
        "particle_analog"
      ],
      "interpretive_layer": [
        "BigBang_analog",
        "cosmos_app",
        "quantum_analog",
        "relativity_analog"
      ]
    },
    "documentation_guidance": {
      "preferred_language": [
        "projects as",
        "corresponds analogically to",
        "within these models",
        "apparent",
        "relational analog",
        "procedural interpretation",
        "macroscopic projection"
      ],
      "discouraged_language": [
        "is literally",
        "proves physics",
        "replaces relativity",
        "gravity is",
        "space is",
        "time is"
      ]
    },
    "agent_enforcement": {
      "required": true,
      "rules": [
        "Agents must automatically append projection suffixes when mapping framework constructs to physics terminology.",
        "Agents must prefer projection wording over identity wording.",
        "Agents must warn when unsuffixed physics terminology appears in derivations.",
        "Agents must preserve distinction between framework primitives and analog observables."
      ]
    }
  }
}
