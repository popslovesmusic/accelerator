{
  "patch_id": "DOCUMENTATION_DEPARTMENT_INDUCTION_001",
  "title": "Documentation Department Induction",
  "status": "PROPOSED",
  "department": "documentation",
  "classification": "CORE_SUPPORT_DEPARTMENT",
  "purpose": "Govern the project's documentation layer, maintain synchronization with live authorities, and ensure documentation accurately reflects the governed state without becoming an execution authority.",
  "mission": "Maintain coherent, synchronized, discoverable, and trustworthy documentation across the Acellorator ecosystem.",
  "authority": {
