      "documentation audits",
      "documentation work queues"
    ],
    "limitations": [
      "May not modify mathematical truth.",
      "May not modify governance truth.",
      "May not promote theorem status.",
      "May recommend documentation changes only."
    ]
  },
  "scope": {
    "owns": [
