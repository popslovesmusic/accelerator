  "governance_rules": [
    {
      "id": "DOC_001",
      "text": "Documentation SHALL accurately reflect the current governed state."
    },
    {
      "id": "DOC_002",
      "text": "Live governance artifacts remain authoritative over documentation."
    },
    {
      "id": "DOC_003",
      "text": "Documentation drift SHALL be reported as governed work."
    },
    {
      "id": "DOC_004",
      "text": "Documentation SHALL never supersede governed registries."
    },
    {
      "id": "DOC_005",
      "text": "Broken references SHALL be classified as documentation debt."
    },
    {
      "id": "DOC_006",
      "text": "Missing onboarding material SHALL be classified as documentation debt."
    },
    {
      "id": "DOC_007",
      "text": "Historical specifications SHALL be clearly identified as historical when superseded by live governance."
    },
    {
      "id": "DOC_008",
      "text": "Every inducted department SHALL maintain documentation sufficient for discovery, onboarding, and governed maintenance."
    }
  ],
  "agent_contract": {
    "before_update": [
      "Read the live authority manifest.",
      "Read the department registry.",
      "Read the relevant department SSOT.",
      "Determine the current authoritative state."
    ],
    "during_update": [
      "Synchronize documentation with live governance.",
      "Never infer authority from documentation.",
      "Preserve historical documentation unless explicitly archived."
    ],
    "after_update": [
      "Run documentation audit.",
      "Report remaining documentation debt.",
      "Generate documentation reduction recommendations."
    ]
  },
  "success_criteria": [
    "Documentation accurately reflects live governance.",
    "Department documentation is discoverable.",
    "Broken references are eliminated.",
    "Documentation drift becomes governed work.",
    "Documentation reduction participates in the Master Work Index."
  ]
