      "Department README files",
      "Department SSOT organization",
      "AGENTS.md consistency",
      "Onboarding documentation",
      "Project navigation",
      "Documentation inventories",
      "Documentation audits",
      "Documentation debt"
    ],
    "does_not_own": [
      "Governance registries",
      "Mathematics registries",
      "Proof registries",
      "Validator logic",
      "Execution artifacts"
    ]
  },
  "primary_responsibilities": [
    "Maintain documentation consistency.",
    "Detect documentation drift.",
    "Maintain onboarding quality.",
    "Maintain documentation discoverability.",
    "Verify documentation references.",
    "Maintain department documentation standards.",
    "Coordinate documentation reduction."
  ],
  "governed_work": [
    {
      "type": "documentation_debt"
    },
    {
      "type": "documentation_review"
    },
    {
      "type": "documentation_sync"
    },
    {
      "type": "documentation_cleanup"
    },
    {
      "type": "documentation_inventory"
    },
    {
      "type": "documentation_onboarding"
    }
  ],
  "analysis_targets": [
    "Broken references",
    "Missing README files",
    "Stale documentation",
    "Encoding issues",
    "Out-of-date onboarding",
    "Historical specification drift",
    "Duplicate documentation",
    "Orphaned documentation",
    "Unreferenced documents",
    "Department documentation consistency"
  ],
  "outputs": [
    "documentation_audit.json",
    "documentation_sync_report.md",
    "documentation_inventory.json",
    "documentation_reduction_plan.json"
  ],
  "reduction_commands": [
    "documentation reduction",
    "documentation debt reduction",
    "documentation review reduction",
    "documentation sync reduction",
    "documentation onboarding reduction"
