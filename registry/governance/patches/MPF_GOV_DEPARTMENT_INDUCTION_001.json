{
  "patch_id": "MPF_GOV_DEPARTMENT_INDUCTION_001",
  "status": "proposed",
  "scope": "global_governance",
  "modifies_ssot_structure": false,
  "purpose": "Establish departments as first-class governed entities and define the induction process for all future departments.",
  "policy": {
    "department_root": "/departments",
    "rule": "All departments SHALL exist as peer directories beneath the common departments root.",
    "reason": [
      "equal constitutional standing",
      "consistent tooling",
      "consistent vector routing",
      "uniform governance",
      "future scalability"
    ]
  },
  "department_minimum_requirements": {
    "required": [
      "department_ssot.md",
      "AGENTS.md"
    ],
    "optional": [
      "registry/",
      "models/",
      "proofs/",
      "validation/",
      "applications/",
      "references/"
    ]
  },
  "inheritance": {
    "inherits": [
      "global governance",
      "claim governance",
      "operator registry",
      "ontology",
      "RT/Core",
      "term registry"
    ],
    "may_define": [
      "local vocabulary",
      "interpretation framework",
      "domain evidence rules",
      "local registries",
      "applications"
    ],
    "may_not_define": [
      "new primitive ontology",
      "replacement governance",
      "replacement RT/Core",
      "replacement operator semantics"
    ]
  },
  "induction_process": [
    "Create department directory.",
    "Create department SSOT.",
    "Create department AGENTS.md.",
    "Declare dependencies on global governance.",
    "Declare department scope.",
    "Declare interpretation boundaries.",
    "Register department.",
    "Begin claim lifecycle."
  ]
}
