{
  "patch_id": "GOV_DEPARTMENT_RELATIONSHIP_REGISTRY_001",
  "title": "Department Relationship Registry",
  "status": "PROPOSED",
  "purpose": "Establish the canonical interaction graph between governed departments while preserving independent departmental authority.",
  "depends_on": [
    "department_registry",
    "authority_manifest",
    "master_work_index"
  ],
  "creates": [
    {
      "path": "governance/live/department_relationship_registry.json",
      "role": "Canonical interaction graph for all governed departments."
    }
  ],
  "principles": [
    "Relationships are directional.",
    "Relationships do not imply authority.",
    "Authority is governed exclusively by the Authority Manifest.",
    "Departments remain independently governed."
  ],
  "relationship_types": [
    "governs",
    "supports",
    "consumes",
    "produces",
    "routes_to",
    "maintains",
    "documents",
    "validates",
    "analyzes",
    "indexes",
    "shares_with",
    "depends_on"
  ],
  "department_relationships": [
    {
      "department": "governance",
      "relationships": [
        {
          "type": "governs",
          "target": "*"
        }
      ]
    },
    {
      "department": "analysis_intake",
      "relationships": [
        {
          "type": "routes_to",
          "target": "analysis"
        },
        {
          "type": "routes_to",
          "target": "mathematics"
        },
        {
          "type": "routes_to",
          "target": "documentation"
        },
        {
          "type": "routes_to",
          "target": "economics"
        },
        {
          "type": "routes_to",
          "target": "physics"
        },
        {
          "type": "routes_to",
          "target": "neuroscience"
        },
        {
          "type": "routes_to",
          "target": "theology"
        }
      ]
    },
    {
      "department": "analysis",
      "relationships": [
        {
          "type": "consumes",
          "target": "master_work_index"
        },
        {
          "type": "analyzes",
          "target": "*"
        },
        {
          "type": "produces",
          "target": "recommendations"
        }
      ]
    },
    {
      "department": "documentation",
      "relationships": [
        {
          "type": "documents",
          "target": "*"
        },
        {
          "type": "maintains",
          "target": "documentation_surfaces"
        }
      ]
    },
    {
      "department": "mathematics",
      "relationships": [
        {
          "type": "supports",
          "target": "physics"
        },
        {
          "type": "supports",
          "target": "economics"
        },
        {
          "type": "supports",
          "target": "theology"
        },
        {
          "type": "supports",
          "target": "ethics"
        },
        {
          "type": "supports",
          "target": "analysis"
        },
        {
          "type": "supports",
          "target": "analysis_intake"
        },
        {
          "type": "supports",
          "target": "neuroscience"
        }
      ]
    }
  ],
  "governance_rules": [
    {
      "id": "DEPT_REL_001",
      "text": "Department relationships SHALL describe operational interaction only."
    },
    {
      "id": "DEPT_REL_002",
      "text": "No relationship SHALL grant authority."
    },
    {
      "id": "DEPT_REL_003",
      "text": "Authority SHALL remain exclusively defined by the Authority Manifest."
    },
    {
      "id": "DEPT_REL_004",
      "text": "Relationship changes SHALL be versioned and governed."
    },
    {
      "id": "DEPT_REL_005",
      "text": "Every inducted department SHALL participate in the relationship registry."
    }
  ],
  "agent_contract": {
    "rules": [
      "Consult the relationship registry before cross-department modifications.",
      "Use relationships for routing, coordination, and dependency analysis.",
      "Do not infer authority from relationships."
    ]
  },
  "success_criteria": [
    "Every inducted department appears in the relationship registry.",
    "Cross-department interactions are explicitly represented.",
    "Authority and interaction are formally separated.",
    "Analysis and Intake can use the registry for deterministic routing."
  ]
}
