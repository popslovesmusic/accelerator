      "index_id": "MASTER_WORK_INDEX_001",
      "generated_by_patch": "GOV_WORK_INDEX_BOOTSTRAP_001",
      "source_framework": "GOV_WORK_REDUCTION_FRAMEWORK_002",
      "projection_only": true
    },
    "summary": {
      "total_items": 0,
      "by_domain": {},
