  },
  "audit_requirements": [
    "Report total indexed items.",
    "Report all source files scanned.",
    "Report source files with zero items.",
    "Report items that could not be normalized.",
    "Report items missing owner, priority, domain, or next_action.",
    "Report whether all known seed sources were represented.",
