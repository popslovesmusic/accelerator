{
  "validation_protocol_v2": {
    "version": "2.0",
    "protocol": "oneproc_governance_v2",
    "gates": [
      "template_gate_v2",
      "metadata_body_consistency_gate",
      "lexicon_gate",
      "measurement_gate_v2",
      "falsification_gate",
      "cpp_preference_gate",
      "language_policy_gate"
    ],
    "intent_limits": {
      "explore": "C2",
      "validate": "C5",
      "publish": "C6"
    },
    "requirements": {
      "multi_seed_uq": true,
      "min_seeds": 3,
      "mechanism_count": 2,
      "independent_measurement_required": true
    },
    "mechanism_types": {
      "dynamics": [
        "pde",
        "ode",
        "discrete_ca",
        "agent"
      ],
      "measurement": [
        "topology_analyzer",
        "spectral_analyzer",
        "network_analysis"
      ]
    },
    "validation_rules": [
      "A hypothesis must be supported by at least one dynamics engine",
      "A hypothesis must be independently verified by at least one measurement engine",
      "Results must be consistent across seeds",
      "Failure in any mechanism invalidates the claim"
    ],
    "confidence_scoring": {
      "C4+": {
        "mechanisms": 3,
        "independent_measurements": 2,
        "uq_pass": true
      },
      "C4": {
        "mechanisms": 2,
        "independent_measurements": 1,
        "uq_pass": true
      },
      "C3": {
        "mechanisms": 1,
        "uq_pass": true
      }
    },
    "independent_measurement_requirement": {
      "version": "1.1",
      "required_for_claim_levels": [
        "C4",
        "C5",
        "C6"
      ],
      "minimum_measurements": {
        "C4": 1,
        "C5": 1,
        "C6": 2
      },
      "valid_measurement_classes": [
        "spectral_analyzer",
        "topology_analyzer",
        "tda",
        "graph_analyzer",
        "bifurcation_analyzer",
        "measurement"
      ],
      "rule": "Independent measurement is REQUIRED for any claim at C4 or higher. A claim may not be promoted unless at least one independent measurement layer confirms the structure or regime distinction.",
      "failure_action": "automatic_downgrade",
      "downgrade_targets": {
        "C4": "C3_single_mechanism_supported",
        "C5": "C4_dual_mechanism_supported",
        "C6": "C5_replicated"
      }
    },
    "cpp_preference_policy": {
      "rule": "When both C++ and Python tools exist for the same model class, C++ MUST be selected for production and high-rigor runs.",
      "preference_order": [
        "C++ (native / AVX2 / SYCL)",
        "Hybrid (C++ backend + Python interface)",
        "Python (only if no C++ exists)"
      ],
      "enforcement": "Python usage for C4+ claims requires explicit justification and flags a governance warning."
    }
  }
}
