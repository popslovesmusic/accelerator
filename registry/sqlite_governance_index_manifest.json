{
  "registry_id": "PCD_SQLITE_GOVERNANCE_INDEX_MANIFEST",
  "version": "1.0.0",
  "database_path": "registry/db/pcd_governance.db",
  "authority_model": {
    "canonical_authority": [
      "JSON registries",
      "Markdown tech notes",
      "reports",
      "empirical result packages",
      "provenance manifests"
    ],
    "sqlite_role": "derived_index_and_search_layer",
    "rebuildable_from_filesystem": true,
    "sqlite_must_not_be_sole_authority": true
  },
  "enabled_features": [
    "relational_indexing",
    "dependency_lookup",
    "claim_traceability",
    "engine_rigor endorsement_lookup",
    "tech_note_full_text_search",
    "publication_binding_lookup",
    "empirical_claim_ledger_lookup"
  ]
}
