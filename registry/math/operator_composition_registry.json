{
  "meta": {
    "version": "1.0",
    "description": "Registry for provisional operator composition laws, ordering constraints, and dependency conditions.",
    "status": "provisional",
    "last_updated": "2026-05-12"
  },
  "composition_classes": [
    {
      "class": "well_typed_composition",
      "meaning": "Codomain of the first operator is admissible input to the next operator."
    },
    {
      "class": "conditionally_closed_composition",
      "meaning": "Composition closes only under declared residue, orientation, branch, or admissibility constraints."
    },
    {
      "class": "order_sensitive_composition",
      "meaning": "Changing operator order changes output class, ambiguity, stability, or admissibility."
    },
    {
      "class": "non_commuting_composition",
      "meaning": "Two operators are not interchangeable under declared conditions."
    },
    {
      "class": "associativity_conditional",
      "meaning": "Associativity holds only under stable intermediate residue/admissibility conditions."
    },
    {
      "class": "undefined_composition",
      "meaning": "Composition relation is not yet formalized."
    }
  ],
