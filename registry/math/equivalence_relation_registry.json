      "discarded_features": ["absolute coordinate", "path history"],
      "supports_theorem": "MT-002"
    },
    {
      "relation_id": "trace_equivalence",
      "definition": "Two artifacts are equivalent if they trace back to the same source-relation aspect role.",
      "preserved_features": ["source pointer", "non-separability metadata"],
      "discarded_features": ["local coordinate", "projection depth"],
      "supports_theorem": "MT-LAW-A"
    },
    {
      "relation_id": "residue_compatibility",
      "definition": "Two residue states are equivalent if they provide the same admissibility-conditioning capability.",
      "preserved_features": ["conditioning role", "memory weight"],
      "discarded_features": ["accumulation sequence", "decay history"]
    },
    {
      "relation_id": "orientation_compatibility",
      "definition": "Two orientation states are equivalent up to declared frame/deviation tolerance.",
      "preserved_features": ["alignment role", "minimization target"],
      "discarded_features": ["literal spatial vector", "rotation count"]
    }
  ],
  "mandatory_constraints": [
    {
      "constraint_id": "EQ-CON-001",
      "statement": "Equivalence is local and declared."
    },
    {
      "constraint_id": "EQ-CON-002",
      "statement": "Equivalence does not imply identity."
