  "equivalence_relation_classes": [
    {
      "class": "admissibility_equivalence",
      "meaning": "Two objects are equivalent if they occupy the same admissibility class under declared window and projection constraints."
    },
    {
      "class": "local_process_state_equivalence",
      "meaning": "Two process states are equivalent within a local transport or identity context."
    },
    {
      "class": "residue_equivalence",
      "meaning": "Two residue states are equivalent if they preserve the same admissibility-conditioning role under declared constraints."
    },
    {
      "class": "orientation_equivalence",
      "meaning": "Two orientation states are equivalent up to declared frame/deviation tolerance."
    },
    {
      "class": "projection_equivalence",
      "meaning": "Distinct preimages may be equivalent under a shared projected observable structure."
    },
    {
      "class": "branch_equivalence",
      "meaning": "Multiple branches may be collapsed if equivalent under declared admissibility, residue, orientation, or projection criteria."
    },
    {
      "class": "reconstruction_equivalence",
      "meaning": "Recovered preimages are equivalent up to declared ambiguity class."
    }
  ],
