    {
      "constraint_id": "EQ-CON-003",
      "statement": "Equivalence does not imply ontology sameness."
    }
  ],
  "governance_rules": [
    {
      "rule_id": "EQ-RULE-001",
      "rule": "Every equivalence relation must explicitly declare preserved and discarded features."
    },
    {
      "rule_id": "EQ-RULE-002",
      "rule": "Equivalence mappings remain strictly within the LOCAL_RESTRICTED_DOMAIN."
    }
  ],
  "forbidden_claims": [
