{
  "meta": {
    "version": "1.0",
    "description": "Registry for baseline stability classifications of operators, theorem scaffolds, and recursive systems.",
    "status": "provisional",
    "last_updated": "2026-05-12"
  },
  "stability_classes": [
    {
      "class": "locally_stable",
      "meaning": "Behavior remains bounded under small admissible perturbations."
    },
    {
      "class": "conditionally_stable",
      "meaning": "Stability depends on declared residue, orientation, pruning, or admissibility constraints."
    },
    {
      "class": "branch_sensitive",
      "meaning": "Stability depends strongly on branching behavior and pruning structure."
    },
    {
      "class": "transport_sensitive",
      "meaning": "Stability depends strongly on transport closure and orientation preservation."
    },
    {
      "class": "equivalence_sensitive",
      "meaning": "Stability depends on equivalence-class collapse/reconstruction behavior."
    },
    {
      "class": "potentially_divergent",
      "meaning": "Known conditions exist under which recursion or branching may diverge."
    },
    {
      "class": "undefined_stability",
      "meaning": "No stability baseline has yet been established."
    }
  ],
