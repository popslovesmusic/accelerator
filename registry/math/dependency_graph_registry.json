    "exit_paths": {
      "rewrite": {
        "requires": [
          "rewrite_patch",
          "new_claim_statement",
          "updated_dependency_graph"
        ],
        "status": "REWRITTEN_PENDING_REVIEW"
      },
      "reroute": {
        "requires": [
          "reroute_patch",
          "new_dependency_edges",
          "claim_cap_recalculation"
        ],
        "status": "REROUTED_PENDING_ATTACK"
      },
      "downgrade": {
        "requires": [
          "downgrade_patch",
          "new_claim_level",
          "audit_entry"
        ],
        "status": "DOWNGRADED"
      },
      "retire": {
        "requires": [
          "retirement_patch",
          "historical_record",
          "downstream_cleanup"
        ],
        "status": "RETIRED"
      },
      "retest": {
        "requires": [
          "new_campaign_id",
          "new_sim_config",
          "audit_entry"
        ],
        "status": "UNDER_ATTACK"
      }
    }
  },
  "dependency_strength_definitions": {
    "REQUIRED": {
      "cap_applies": true,
      "description": "Downstream object cannot exceed this dependency's current claim level."
    },
    "SUPPORTIVE": {
      "cap_applies": false,
      "description": "Dependency informs confidence but does not automatically cap promotion unless declared essential."
    },
    "SPECULATIVE": {
      "cap_applies": false,
      "description": "May guide research but cannot support or block claim promotion."
    },
    "BLOCKING": {
