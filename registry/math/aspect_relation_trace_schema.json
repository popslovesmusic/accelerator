      "retained_features": [
        "distinction",
        "admissibility"
      ],
      "lost_or_abstracted_features": [
        "simultaneous continuation aspect",
        "full residue-binding context"
      ],
      "non_separability_acknowledged": true,
      "primitive_status": false,
      "claim_level": "ANALOG_MODEL_ONLY",
      "promotion_allowed": false
    },
    {
      "trace_id": "PALG-TRACE-002",
      "source_relation": "(-1) <=>R (+1)",
      "aspect_label": "-1",
      "aspect_role": "polarity",
