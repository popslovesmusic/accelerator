    "scope_status": "STRICTLY_LOCAL_RESTRICTED_DOMAIN",
    "physics_status": "NON_PHYSICAL_ANALOG_MODEL"
  },
  "composite_schema": {
    "index_id": "string",
    "inputs": {
      "trace_quality": "float",
      "loss_differential_clarity": "float",
      "conflict_preservation": "float",
      "coherence_without_identity": "float",
      "recoverability_bound_integrity": "float",
      "projection_drift_risk": "float"
    },
    "calculation_method": "weighted_average_with_critical_overrides",
    "safety_states": [
      "SAFE_ANALOG_USE",
      "PASS_WITH_WARNINGS",
      "REVIEW_REQUIRED",
      "REJECT_ESCALATION"
