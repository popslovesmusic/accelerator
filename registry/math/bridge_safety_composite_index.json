  "critical_overrides": [
    {
      "trigger": "projection_drift_risk > 0.6",
      "action": "FORCE_REJECT_ESCALATION"
    },
    {
      "trigger": "conflict_preservation < 1.0",
      "action": "FORCE_REJECT_ESCALATION"
    },
    {
      "trigger": "loss_differential_clarity < 0.7",
      "action": "FORCE_REVIEW_REQUIRED"
    }
  ],
  "governance_rules": [
    {
      "rule_id": "BSCI-RULE-001",
      "rule": "The composite index is a governance tool, not a physical metric."
    },
    {
      "rule_id": "BSCI-RULE-002",
      "rule": "A 'SAFE_ANALOG_USE' result does not authorize physical theory promotion."
    }
  ],
  "forbidden_claims": [
