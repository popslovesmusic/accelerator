{
  "patch_id": "MPF-PALG-048",
  "name": "Bridge Safety Composite Index",
  "status": "active",
  "metric_status": "METRICS_SCAFFOLD_ONLY",
  "purpose": "Combine trace quality, loss clarity, conflict preservation, coherence, recoverability bounds, and drift detection into a governance-only safety score.",
  "source_relation": "(E≠0) ⇔R δ(E>0)",
  "non_separability_acknowledged": true,
  "no_unification_guardrail": "no QM/GR unification, derivation, replacement, or physics claim; only analog projection behavior",
  "governance_status": {
