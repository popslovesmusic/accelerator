{
  "meta": {
    "version": "1.0",
    "description": "Registry for the Derivation Graph Atlas (META004).",
    "status": "active",
    "last_updated": "2026-05-13"
  },
  "atlas_layer": {
    "id": "META004",
    "name": "Derivation Graph Atlas",
    "status": "active",
    "purpose": "Provide explicit visual and textual dependency maps for derivation chains, theorem dependencies, recursive campaigns, operator flows, and open-question frontiers.",
    "depends_on": [
      "META003",
      "META001",
      "MT-001",
      "MT-002",
      "MT-003",
      "RC-001",
      "RC-002",
      "RC-003_to_RC-031",
      "proof_elevation_campaign",
      "counterexample_campaign",
      "operator_composition",
      "recursive_convergence",
      "selection_uniqueness"
    ],
    "atlas_outputs": [
      {
        "id": "derivation_graph",
        "file_path": "docs/math/atlas_derivation_graph.md",
        "description": "Graph of derivation chains and logical steps."
      },
      {
        "id": "theorem_dependency_graph",
        "file_path": "docs/math/atlas_theorem_dependency_graph.md",
        "description": "Map of dependencies between local theorem candidates."
      },
      {
        "id": "recursive_campaign_topology",
        "file_path": "docs/math/atlas_recursive_campaign_topology.md",
        "description": "Topology of the Recursive Convergence (RC) program."
      },
      {
        "id": "operator_flow_map",
        "file_path": "docs/math/atlas_operator_flow_map.md",
        "description": "Map of data and constraint flow between core operators."
      },
      {
        "id": "open_question_dependency_map",
        "file_path": "docs/math/atlas_open_question_dependency_map.md",
        "description": "Dependency map of open research questions to theorem stability."
      }
    ],
    "atlas_construction_conditions": [
      "theorem_dependency_graph_present",
      "derivation_graph_present",
      "recursive_campaign_topology_present",
      "operator_flow_map_present",
      "open_question_dependency_map_present",
      "cross_references_to_codex_present",
      "theorem_statuses_preserved",
      "validation_governance_unchanged"
    ],
    "failure_modes_to_preserve": [
      "graph_implies_unproven_closure",
      "dependency_direction_reversal",
      "hidden_theorem_elevation",
      "operator_overgeneralization",
      "open_question_suppression",
      "counterexample_history_omission",
      "validation_governance_bypass",
      "false_topological_completion"
    ],
    "governance_constraints": {
      "must_not_claim_global_closure": true,
      "must_not_claim_physics_validation": true,
      "must_not_modify_theorem_status_implicitly": true,
      "must_preserve_open_questions": true,
      "must_preserve_counterexample_history": true,
      "must_preserve_failure_modes": true,
      "must_preserve_validation_governance": true
    }
  }
}