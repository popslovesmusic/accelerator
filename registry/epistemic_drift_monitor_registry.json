{
  "registry_id": "PCD_EPISTEMIC_DRIFT_MONITOR_REGISTRY",
  "version": "1.0.0",
  "schema": {
    "required_fields": [
      "monitor_rule_id",
      "trigger_pattern",
      "required_context",
      "detected_risk",
      "severity",
      "required_action",
      "failure_behavior"
    ]
  },
  "rules": [
    {
      "monitor_rule_id": "EDM-001",
      "trigger_pattern": [
        "proved",
        "verified",
        "confirmed",
        "demonstrates physical reality"
      ],
      "required_context": [
        "linked_theorem_status",
        "linked_confidence_band",
        "linked_result_package"
      ],
      "detected_risk": "unsupported certainty escalation",
      "severity": "HIGH",
      "required_action": "compare language against theorem status and confidence ceiling",
      "failure_behavior": "rewrite_or_block_publication"
    },
    {
      "monitor_rule_id": "EDM-002",
      "trigger_pattern": [
        "universal law",
        "final closure",
        "complete derivation"
      ],
      "required_context": [
        "gap_dependency_graph",
        "open_gap_registry"
      ],
      "detected_risk": "closure overreach",
      "severity": "HIGH",
      "required_action": "check unresolved gaps and partial derivations",
      "failure_behavior": "downgrade_language_and_open_review"
    },
    {
      "monitor_rule_id": "EDM-003",
      "trigger_pattern": [
        "simulation proves",
        "empirically verified"
      ],
      "required_context": [
        "confidence_band",
        "rigor endorsement_level",
        "runtime_validation"
      ],
      "detected_risk": "simulation-to-physical overextension",
      "severity": "CRITICAL",
      "required_action": "enforce governed model-language constraints",
      "failure_behavior": "block_claim_language"
    },
    {
      "monitor_rule_id": "EDM-004",
      "trigger_pattern": [
        "cross-mechanism support"
      ],
      "required_context": [
        "mechanism_count",
        "tool_rigor endorsement_levels"
      ],
      "detected_risk": "false mechanism plurality",
      "severity": "MEDIUM",
      "required_action": "verify independent certified mechanisms exist",
      "failure_behavior": "downgrade_to_single_mechanism_language"
    }
  ]
}
