{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acellorator.local/schemas/rt_attack_candidate_action_v1.json",
  "title": "RT Candidate Action",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "action_id", "source_findings", "action_type", "status", "authority_boundary", "rationale"],
  "properties": {
    "schema_id": { "const": "rt_attack_candidate_action_v1" },
    "action_id": { "type": "string", "pattern": "^RT_ACTION_[A-Z0-9_]+$" },
    "source_findings": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^FINDING_[A-Z0-9_]+$" } },
    "action_type": { "enum": ["PRESERVE_EVIDENCE", "ADD_PROVISIONAL_NOTE", "REVISE_FORMULATION", "OPEN_RESEARCH_OBLIGATION", "REJECT", "DEFER"] },
    "status": { "enum": ["DRAFT", "HUMAN_DECISION_REQUIRED", "ACCEPTED_FOR_RT_REVIEW", "REJECTED", "DEFERRED"] },
    "authority_boundary": { "const": "NO_AUTOMATIC_RT_MUTATION" },
    "rationale": { "type": "string", "minLength": 1 },
    "affected_rt_paths": { "type": "array", "items": { "type": "string" } },
    "successor_attack_request": { "type": ["object", "null"] }
  }
}
