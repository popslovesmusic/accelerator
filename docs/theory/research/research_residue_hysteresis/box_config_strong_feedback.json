{
  "grid": {
    "nx": 128,
    "length": 1.0,
    "dt": 1.0e-3,
    "t_final": 20.0,
    "save_every": 100
  },
  "model": {
    "D_epsilon": 6.0e-4,
    "D_rho": 4.0e-4,
    "D_R": 2.0e-4,
    "a": 0.5,
    "b": 1.2,
    "c": 2.0,
    "alpha": 0.7,
    "beta": 0.8,
    "gamma": 1.2,
    "u": 0.5,
    "v": 0.1,
    "kappa": 0.6,
    "lambda_R": 0.8,
    "s": 0.005,
    "h": 0.08,
    "clamp_nonnegative": true,
    "epsilon_activity_threshold": 0.05
  },
  "initial_condition": {
    "epsilon_kind": "gaussian_bump",
    "epsilon_base": 0.0,
    "epsilon_amplitude": 0.4,
    "epsilon_sigma": 0.1,
    "epsilon_offset": 0.0,
    "rho_kind": "uniform",
    "rho_base": 0.3,
    "residue_kind": "zero",
    "noise_std": 0.01,
    "seed": 42
  },
  "box": {
    "epsilon_max": 1.0,
    "rho_min": 0.0,
    "rho_max": 1.0,
    "residue_max": 2.0
  },
  "output_dir": "research_residue_hysteresis/outputs/hysteresis_v3"
}
