{
  "grid": {
    "nx": 1024,
    "length": 200.0,
    "dt": 0.01,
    "t_final": 2000,
    "save_every": 1000
  },
  "model": {
    "D_epsilon": 0.015,
    "D_rho": 0.075,
    "D_R": 0.0,
    "a": 0.95,
    "b": 0.95,
    "c": 0.65,
    "alpha": 1.05,
    "beta": 0.65,
    "gamma": 0.45,
    "u": 1.0,
    "v": 1.0,
    "kappa": 0.55,
    "lambda_R": 0.10,
    "s": 0.0,
    "h": 0.0,
    "clamp_nonnegative": true
  },
  "initial_condition": {
    "epsilon_kind": "gaussian_bump",
    "epsilon_amplitude": 0.3,
    "epsilon_sigma": 5.0,
    "epsilon_offset": 0.0,
    "rho_kind": "uniform",
    "rho_base": 0.5,
    "noise_std": 0.01,
    "seed": 2026
  },
  "box": {
    "epsilon_max": 2.0,
    "rho_min": 0.0,
    "rho_max": 2.0,
    "residue_max": 5.0
  },
  "output_dir": "outputs/r2_anchor"
